# Used by `prisma migrate`/`prisma db seed` -- a privileged role that owns the schema.
# Never point the running API server at this URL; it can bypass RLS as the table owner.
#
# Use 127.0.0.1, not localhost: on at least one dev machine, Node resolves "localhost" to
# ::1 first, and Docker Desktop's IPv6 port-publish for Postgres didn't actually work
# (silent, consistent ~5s PrismaClientInitializationError/P1001 on every query, even
# though `curl`/`psql`/Test-NetConnection all "worked" -- they either default to IPv4 or
# fall back to it, unlike Prisma's Rust query engine, which doesn't).
DATABASE_URL="postgresql://brandmonitor:brandmonitor@127.0.0.1:5450/brandmonitor"

# Used by the running API server (apps/api/src/db.ts) -- the restricted role created in
# the 20260910000000_multi_tenancy_rls migration. NOSUPERUSER/NOBYPASSRLS: RLS policies
# actually apply to it. Change this password before deploying anywhere beyond local dev.
DATABASE_APP_URL="postgresql://brandmonitor_app:brandmonitor_app_dev_password@127.0.0.1:5450/brandmonitor"

# 127.0.0.1, not localhost -- same IPv6/::1 port-publish issue as DATABASE_URL above,
# just hitting the scanner container's port instead of Postgres's. Confirmed the same
# way: a raw connection to ::1:3100 hangs/times out on this machine even though the
# container is genuinely up and curl/docker exec against it work fine.
SCANNER_URL="http://127.0.0.1:3100"
PORT=4000

# Clerk (https://dashboard.clerk.com -> your app -> API Keys)
CLERK_SECRET_KEY=""
CLERK_WEBHOOK_SIGNING_SECRET=""

# SMTP for alert emails. A Gmail app-password works for MVP/dev volume (Settings ->
# Security -> 2-Step Verification -> App passwords) -- swap to a real transactional
# provider's SMTP credentials before relying on this at any real send volume.
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=465
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM=""

# Used to build links back to the web app in alert emails.
WEB_APP_URL="http://localhost:3000"

# Anthropic (https://console.anthropic.com) -- Stage E AI threat-explanation. The model
# narrates the deterministic score/evidence, never sets it. AI_EXPLANATION_DAILY_LIMIT is
# a per-org cost guardrail (sliding 24h window, counts every attempt including failures).
ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL="claude-sonnet-5"
AI_EXPLANATION_DAILY_LIMIT=100
