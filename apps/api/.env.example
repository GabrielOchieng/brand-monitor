# Used by `prisma migrate`/`prisma db seed` -- a privileged role that owns the schema.
# Never point the running API server at this URL; it can bypass RLS as the table owner.
#
# Use 127.0.0.1, not localhost: on at least one dev machine, Node resolves "localhost" to
# ::1 first, and Docker Desktop's IPv6 port-publish for Postgres didn't actually work
# (silent, consistent ~5s PrismaClientInitializationError/P1001 on every query, even
# though `curl`/`psql`/Test-NetConnection all "worked" -- they either default to IPv4 or
# fall back to it, unlike Prisma's Rust query engine, which doesn't).
DATABASE_URL="postgresql://brandmonitor:brandmonitor@127.0.0.1:5450/brandmonitor"

# Used by the running API server (apps/api/src/db.ts) -- the restricted role created in
# the 20260910000000_multi_tenancy_rls migration. NOSUPERUSER/NOBYPASSRLS: RLS policies
# actually apply to it. Change this password before deploying anywhere beyond local dev.
DATABASE_APP_URL="postgresql://brandmonitor_app:brandmonitor_app_dev_password@127.0.0.1:5450/brandmonitor"

# 127.0.0.1, not localhost -- same IPv6/::1 port-publish issue as DATABASE_URL above,
# just hitting the scanner container's port instead of Postgres's. Confirmed the same
# way: a raw connection to ::1:3100 hangs/times out on this machine even though the
# container is genuinely up and curl/docker exec against it work fine.
SCANNER_URL="http://127.0.0.1:3100"
PORT=4000

# SMTP for alert emails. A Gmail app-password works for MVP/dev volume (Settings ->
# Security -> 2-Step Verification -> App passwords) -- swap to a real transactional
# provider's SMTP credentials before relying on this at any real send volume.
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=465
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM=""

# The web app's exact origin: email links, the CORS allowlist and the Origin check on writes.
WEB_APP_URL="http://localhost:3000"

# Session cookie domain. Production: the parent domain the web app and API share, so the web
# app's middleware sees the cookie. Local dev: leave empty (host-only cookie on localhost).
COOKIE_DOMAIN=""

# Encrypts 2FA secrets: 32 random bytes, base64. Generate once and keep a copy; changing or losing it
# locks out every user with 2FA on (fix: npm run auth:disable-2fa). Empty = 2FA can't be turned on.
#   node -e "console.log(crypto.randomBytes(32).toString('base64'))"
AUTH_ENCRYPTION_KEY=""

# Sign in with Google (optional): an OAuth client of type "Web application" (DEPLOYMENT.md §4).
# Both empty = no Google button. Its authorized redirect URI must be <API_PUBLIC_URL>/auth/google/callback.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
API_PUBLIC_URL="http://localhost:4000"

# 1 = start without queue workers or cron dispatchers (nothing scans or sends alert emails).
# Handy for UI / sign-in work; manual discovery runs from the dashboard won't work.
DISABLE_SCHEDULERS=""

# AI threat-explanation (Stage E), via any OpenAI-compatible Chat Completions API. Default
# is Google Gemini's free tier: create a key at https://aistudio.google.com (no card). For Groq
# instead: AI_BASE_URL="https://api.groq.com/openai/v1" and a Groq model id. The model
# narrates the deterministic score/evidence, never sets it. AI_EXPLANATION_DAILY_LIMIT is a
# per-org guardrail (sliding 24h window, counts every attempt including failures).
AI_API_KEY=""
AI_BASE_URL="https://generativelanguage.googleapis.com/v1beta/openai"
# Comma-separated fallback chain: if one model fails (overloaded, quota spent) the next is tried.
AI_MODEL="gemini-2.5-flash,gemini-flash-lite-latest,gemini-3.5-flash"
AI_EXPLANATION_DAILY_LIMIT=100

# Cloudflare Turnstile secret for the public "report a scam" form (/report/<token>). Free
# plan, no card. Leave empty to skip the CAPTCHA (honeypot + per-IP limit only). The
# matching site key goes to the web app as NEXT_PUBLIC_TURNSTILE_SITE_KEY.
TURNSTILE_SECRET_KEY=""

# Tavily web search for social-account and fact-check discovery (pipeline/socialSearchMonitorJob.ts).
# Free plan: 1,000 searches/month, no card -- https://tavily.com. Empty = those jobs don't run.
# TAVILY_MONTHLY_CAP is a hard stop below the free allowance.
TAVILY_API_KEY=""
TAVILY_MONTHLY_CAP=900

# Contact (email or URL) put in the User-Agent when downloading SANS ISC's recent-domains
# feed (lib/iscRecentDomains.ts). ISC asks automated clients to identify themselves.
ISC_CONTACT=""
# Optional: CT log operators to read (pipeline/ctMonitorJob.ts). Default Let's Encrypt (~0.7 GB/day);
# "all" adds every log that serves names tiles (~3 GB/day).
CT_LOG_OPERATORS="Let's Encrypt"
