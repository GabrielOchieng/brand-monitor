generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// POC v0 note: no organization_id RLS enforcement yet (single seeded tenant, no auth).
// Table/field names match ARCHITECTURE.md §7 so this is a forward-compatible subset,
// not a throwaway schema.

model Organization {
  // org_<random>. Orgs created before 2026-11 carry their old Clerk id (same prefix).
  id                    String       @id
  name                  String
  createdAt             DateTime     @default(now()) @map("created_at")
  // Set by a platform admin: nothing in this org is monitored while set (lib/monitoredBrands.ts).
  monitoringPausedAt    DateTime?    @map("monitoring_paused_at")
  monitoringPausedBy    String?      @map("monitoring_paused_by") // admin's email
  // Set by a platform admin once the org's authorization to report in its name is on file:
  // automatic takedown reporting can only run while set (lib/takedownAutomation.ts).
  autoTakedownAllowedAt DateTime?    @map("auto_takedown_allowed_at")
  autoTakedownAllowedBy String?      @map("auto_takedown_allowed_by") // admin's email
  brands                Brand[]
  memberships           Membership[]

  @@map("organizations")
}

model User {
  // user_<random>. Users created before 2026-11 carry their old Clerk id (same prefix).
  id           String   @id
  email        String   @unique // stored lowercased
  name         String?
  // Platform-wide role, above every organization: null (normal user) or "admin" (the admin
  // panel). Set only from the container (scripts/makeAdmin.ts), never through the API.
  // "superadmin" (can make other admins) is reserved for later.
  platformRole String?  @map("platform_role")
  createdAt    DateTime @default(now()) @map("created_at")

  memberships      Membership[]
  assignedFindings Finding[]    @relation("FindingAssignee")
  auth             UserAuth?
  sessions         Session[]

  @@map("users")
}

// Credentials, kept out of `users` so no tenant query that includes a user can ever return
// them. No RLS and no grants for brandmonitor_app: only src/auth/* touches these, through
// adminPrisma (see adminDb.ts).
model UserAuth {
  userId             String    @id @map("user_id")
  user               User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  passwordHash       String?   @map("password_hash") // scrypt$N$r$p$salt$hash; null = no password set yet
  passwordChangedAt  DateTime? @map("password_changed_at")
  emailVerifiedAt    DateTime? @map("email_verified_at")
  totpSecretEnc      String?   @map("totp_secret_enc") // AES-256-GCM, AUTH_ENCRYPTION_KEY
  totpEnabledAt      DateTime? @map("totp_enabled_at")
  totpLastStep       BigInt?   @map("totp_last_step") // last accepted time step, blocks replay
  recoveryCodeHashes String[]  @default([]) @map("recovery_code_hashes")
  googleSub          String?   @unique @map("google_sub")
  updatedAt          DateTime  @updatedAt @map("updated_at")

  @@map("user_auth")
}

model Session {
  id             String   @id @default(cuid())
  tokenHash      String   @unique @map("token_hash") // sha256 of the cookie value
  userId         String   @map("user_id")
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  activeOrgId    String?  @map("active_org_id")
  // Platform admin's read-only view into an org (routes/admin.ts). While set, authenticate()
  // uses this org with role viewer and refuses every write.
  adminViewOrgId String?  @map("admin_view_org_id")
  createdAt      DateTime @default(now()) @map("created_at")
  lastSeenAt     DateTime @default(now()) @map("last_seen_at")
  expiresAt      DateTime @map("expires_at")
  ip             String?
  userAgent      String?  @map("user_agent")

  @@index([userId])
  @@map("sessions")
}

// One-time emailed/short-lived tokens. Single-use: consumed with a conditional update.
model AuthToken {
  id             String    @id @default(cuid())
  tokenHash      String    @unique @map("token_hash")
  purpose        String // reset_password | invite | change_email | mfa_challenge | oauth_state
  userId         String?   @map("user_id")
  email          String?
  organizationId String?   @map("organization_id")
  role           String?
  newEmail       String?   @map("new_email")
  data           Json?
  createdBy      String?   @map("created_by")
  attempts       Int       @default(0)
  createdAt      DateTime  @default(now()) @map("created_at")
  expiresAt      DateTime  @map("expires_at")
  usedAt         DateTime? @map("used_at")

  @@index([purpose, organizationId])
  @@index([purpose, userId])
  @@map("auth_tokens")
}

model Membership {
  id             String       @id @default(cuid())
  userId         String       @map("user_id")
  user           User         @relation(fields: [userId], references: [id])
  organizationId String       @map("organization_id")
  organization   Organization @relation(fields: [organizationId], references: [id])
  role           String       @default("analyst") // owner | admin | analyst | viewer
  createdAt      DateTime     @default(now()) @map("created_at")

  @@unique([userId, organizationId])
  @@map("memberships")
}

model Brand {
  id                  String       @id @default(cuid())
  organizationId      String       @map("organization_id")
  organization        Organization @relation(fields: [organizationId], references: [id])
  name                String
  primaryDomain       String       @map("primary_domain")
  // Set by a platform admin: this brand isn't monitored while set (lib/monitoredBrands.ts).
  monitoringPausedAt  DateTime?    @map("monitoring_paused_at")
  monitoringPausedBy  String?      @map("monitoring_paused_by") // admin's email
  // Unguessable token in the public "report a scam" link (/report/<token>). Null = the
  // brand has no public form. Rotating it kills every copy of the old link.
  reportToken         String?      @unique @map("report_token")
  // The brand's real social accounts, as canonical profile URLs (lib/socialUrls.ts) --
  // social search never reports these, and handle-impersonation scoring skips them.
  officialSocialUrls  String[]     @default([]) @map("official_social_urls")
  // Automatic takedown reporting for this brand (when the org has it on). Off = manual only.
  autoTakedownEnabled Boolean      @default(true) @map("auto_takedown_enabled")
  createdAt           DateTime     @default(now()) @map("created_at")

  domains      BrandDomain[]
  keywords     BrandKeyword[]
  assets       BrandAsset[]
  findings     Finding[]
  pipelineRuns PipelineRun[]
  mentions     BrandMention[]

  @@map("brands")
}

model BrandDomain {
  id      String @id @default(cuid())
  brandId String @map("brand_id")
  brand   Brand  @relation(fields: [brandId], references: [id])
  domain  String
  type    String @default("primary") // primary | secondary | allowlist

  @@unique([brandId, domain])
  @@map("brand_domains")
}

model BrandKeyword {
  id      String @id @default(cuid())
  brandId String @map("brand_id")
  brand   Brand  @relation(fields: [brandId], references: [id])
  keyword String
  type    String @default("name") // name | concat_term | concat_term_core

  @@unique([brandId, keyword])
  @@map("brand_keywords")
}

model BrandAsset {
  id        String   @id @default(cuid())
  brandId   String   @map("brand_id")
  brand     Brand    @relation(fields: [brandId], references: [id])
  type      String // favicon | screenshot | contact_indicators
  sourceUrl String   @map("source_url")
  hash      String
  createdAt DateTime @default(now()) @map("created_at")

  @@map("brand_assets")
}

model Finding {
  id                String    @id @default(cuid())
  brandId           String    @map("brand_id")
  brand             Brand     @relation(fields: [brandId], references: [id])
  // domain | url | social (a social-media account; identifier is its canonical profile URL)
  type              String    @default("domain")
  source            String    @default("pipeline") // pipeline | seed_demo | manual_submission | ct_log | app_store | nrd | nrd_hagezi | isc_recent | phish_feed | public_report | social_search | web_search
  identifier        String // the candidate domain
  riskScore         Int       @default(0) @map("risk_score")
  severity          String    @default("low")
  status            String    @default("new")
  firstDetectedAt   DateTime  @default(now()) @map("first_detected_at")
  lastScannedAt     DateTime  @default(now()) @map("last_scanned_at")
  // Drives the recheck dispatcher (apps/api/src/queue/dispatch.ts) -- null means never
  // enrolled for recheck (shouldn't happen once discovery sets it at creation).
  nextScanAt        DateTime? @map("next_scan_at")
  // Points at this finding's most recent Scan -- the O(1) way to fetch "current"
  // score-event/evidence breakdown without a MAX(createdAt) aggregate, now that scans
  // are append-only (see Scan below).
  lastScanId        String?   @map("last_scan_id")
  // Lifecycle: who's investigating (must be a member of this finding's org -- enforced
  // in the route, not by this FK alone, since a raw User row isn't tenant-scoped) and
  // free-form labels. Neither drives any pipeline behavior; display/filtering only.
  assigneeId        String?   @map("assignee_id")
  assignee          User?     @relation("FindingAssignee", fields: [assigneeId], references: [id])
  tags              String[]  @default([])
  // Post-takedown watch (see recheckJob.ts): set when a scan of a resolved / taken-down
  // finding definitively shows the site down (no DNS, parked, or HTTP 404/410/451), cleared
  // when it comes back live -- which is what fires site_reactivated. Requiring a definite
  // "down" first stops a single failed scan from looking like a reactivation.
  downSince         DateTime? @map("down_since")
  // Consecutive definitely-down scans while not yet confirmed down: downSince is only set at 2,
  // because the parked-page detector occasionally misreads one scan of a live site.
  downStreak        Int       @default(0) @map("down_streak")
  // First scan that saw live, non-parked content. website_activated fires only when this was
  // still null, so a live site whose scans flap live/parked doesn't re-alert on every return.
  firstLiveAt       DateTime? @map("first_live_at")
  // Consecutive scans that saw live content (a failed scan leaves it; a down scan resets it).
  // Automatic takedown reports need 2, so one misread scan never triggers one.
  liveStreak        Int       @default(0) @map("live_streak")
  // Last time a confirmed-down site came back (site_reactivated): reports from before it don't
  // count as "already reported" any more.
  lastReactivatedAt DateTime? @map("last_reactivated_at")
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")

  domainIntel    DomainIntel?
  websiteIntel   WebsiteIntel?
  evidence       FindingEvidence[]
  scoreEvents    FindingScoreEvent[]
  scans          Scan[]
  notes          FindingNote[]
  aiExplanations AiExplanation[]
  takedowns      Takedown[]
  changes        FindingChange[]
  indicators     FindingIndicator[]
  socialIntel    SocialIntel?

  @@unique([brandId, identifier])
  // brandId-leading composites, not standalone single-column indexes -- the RLS policy on
  // this table always carries an implicit brand_id IN (...) predicate, so these match how
  // the threat-feed filters/sorts are actually queried (see routes/findings.ts).
  @@index([brandId, status])
  @@index([brandId, severity])
  @@index([brandId, assigneeId])
  @@index([brandId, riskScore])
  @@map("findings")
}

model FindingNote {
  id        String   @id @default(cuid())
  findingId String   @map("finding_id")
  finding   Finding  @relation(fields: [findingId], references: [id])
  authorId  String   @map("author_id")
  body      String
  createdAt DateTime @default(now()) @map("created_at")

  @@map("finding_notes")
}

// Pure manual record-keeping -- no code here ever calls a registrar/hosting-provider API
// (that's Phase 3, out of MVP scope per ARCHITECTURE.md). One-to-many from Finding: a
// registrar report and a hosting-provider report are independent efforts with their own
// tickets/timelines, tracked as separate rows rather than fields on Finding.
model Takedown {
  id            String    @id @default(cuid())
  findingId     String    @map("finding_id")
  finding       Finding   @relation(fields: [findingId], references: [id])
  provider      String // free text, e.g. "registrar" / "GoDaddy" / "hosting provider"
  reference     String? // their ticket/case number
  status        String    @default("requested") // requested | acknowledged | completed | rejected
  notes         String?
  requestedById String    @map("requested_by_id") // always server-set from the caller's token
  requestedAt   DateTime  @default(now()) @map("requested_at")
  // First-ever transition into completed/rejected -- set once, never overwritten by a
  // later correction (mirrors firstDetectedAt vs. lastScannedAt's "first fact vs. latest
  // fact" split above). A status correction after the fact belongs in `notes`, not here.
  resolvedAt    DateTime? @map("resolved_at")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  @@map("takedown_requests")
}

// One row per discovery/recheck execution against a finding. Score events/evidence are
// append-only and tagged with the scan that produced them (see FindingScoreEvent/
// FindingEvidence below) -- this is what makes "show only the current breakdown" and "show
// full history over time" both possible from the same append-only data, instead of having
// to choose one. A scan's score/severity are an absolute recomputation each time
// (computeScore in scoring.ts), never incremental -- a future timeline view must group by
// scan, never flatten FindingScoreEvent rows across scans (that would double-count a rule
// like a homoglyph match that's still true on every recheck).
model Scan {
  id          String    @id @default(cuid())
  findingId   String    @map("finding_id")
  finding     Finding   @relation(fields: [findingId], references: [id])
  kind        String // discovery | recheck
  triggeredBy String    @map("triggered_by") // manual | scheduled
  score       Int?
  severity    String?
  startedAt   DateTime  @default(now()) @map("started_at")
  finishedAt  DateTime? @map("finished_at")
  error       String?

  scoreEvents   FindingScoreEvent[]
  evidence      FindingEvidence[]
  aiExplanation AiExplanation?

  @@map("scans")
}

// One row per (attempted) AI narration of a scan's deterministic score/evidence -- keyed
// by scanId, never findingId, so it can't go stale: Scan.id is always a fresh cuid and
// Finding.lastScanId only ever advances forward, so once a recheck moves on, the old
// explanation simply stops matching rather than needing an "outdated" flag maintained
// elsewhere. `prompt` is the exact context sent to the model -- the audit trail
// ARCHITECTURE.md §9 requires. status/error are written even on failure (not just
// success) so a failed attempt still counts toward the per-org rate limit in
// routes/findings.ts and leaves an honest record, rather than a silent, unaudited spend.
model AiExplanation {
  id        String   @id @default(cuid())
  scanId    String   @unique @map("scan_id")
  scan      Scan     @relation(fields: [scanId], references: [id])
  findingId String   @map("finding_id")
  finding   Finding  @relation(fields: [findingId], references: [id])
  prompt    String
  response  String?
  model     String
  status    String   @default("pending") // pending | succeeded | failed
  error     String?
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("ai_explanations")
}

model DomainIntel {
  id                  String    @id @default(cuid())
  findingId           String    @unique @map("finding_id")
  finding             Finding   @relation(fields: [findingId], references: [id])
  registrar           String?
  registeredAt        DateTime? @map("registered_at")
  nameservers         String[]
  ip                  String?
  dnsRecords          Json?     @map("dns_records")
  whoisSource         String?   @map("whois_source") // rdap | whois | unavailable
  rawData             Json?     @map("raw_data")
  // First-ever time DNS delegation was observed for this domain -- set once, never
  // overwritten (same "first fact, never overwritten" pattern as Finding.firstDetectedAt
  // and Takedown.resolvedAt). Null means we've never once confirmed this domain actually
  // resolves -- still just a candidate, not a proven registration. currentlyResolves
  // reflects only the LATEST scan, so `firstResolvedAt != null && !currentlyResolves` is
  // the "was registered, isn't anymore" (lapsed) case a typosquat can genuinely hit --
  // e.g. a brief test-registration, or a hold period expiring after discovery flagged it.
  firstResolvedAt     DateTime? @map("first_resolved_at")
  currentlyResolves   Boolean   @default(false) @map("currently_resolves")
  // Registry facts beyond creation date (see lib/rdap.ts). Kept from the previous scan when
  // a lookup fails, rather than blanked.
  lastChangedAt       DateTime? @map("last_changed_at")
  expiresAt           DateTime? @map("expires_at")
  statusCodes         String[]  @default([]) @map("status_codes")
  registrarAbuseEmail String?   @map("registrar_abuse_email")
  registrarAbusePhone String?   @map("registrar_abuse_phone")
  registrarIanaId     String?   @map("registrar_iana_id")
  // Who hosts the IP, from IP RDAP. hostingLookupIp is the IP these describe, so the
  // lookup only re-runs when the IP changes.
  hostingOrg          String?   @map("hosting_org")
  hostingAbuseEmail   String?   @map("hosting_abuse_email")
  hostingLookupIp     String?   @map("hosting_lookup_ip")

  @@map("domain_intel")
}

// Append-only history of registration/DNS changes between scans, plus post-takedown
// reactivations (field "site"). Written by recheckJob.ts; see pipeline/registrationChanges.ts.
model FindingChange {
  id         String   @id @default(cuid())
  findingId  String   @map("finding_id")
  finding    Finding  @relation(fields: [findingId], references: [id])
  scanId     String   @map("scan_id")
  field      String // registrar | nameservers | last_changed | expires | status | ip | site
  oldValue   String?  @map("old_value")
  newValue   String?  @map("new_value")
  detectedAt DateTime @default(now()) @map("detected_at")

  @@index([findingId, detectedAt])
  @@map("finding_changes")
}

// Contact/payment details seen on a finding's page (lib/indicators.ts). Never deleted
// when a later scan stops showing them -- lastSeenAt just stops moving -- so a number the
// scammer swapped out still links its old pages to new ones. brandId is denormalized so
// "who else uses this number" is one index lookup, and RLS can key on it directly.
model FindingIndicator {
  id          String   @id @default(cuid())
  findingId   String   @map("finding_id")
  finding     Finding  @relation(fields: [findingId], references: [id])
  brandId     String   @map("brand_id")
  kind        String // phone | whatsapp | mpesa_paybill | mpesa_till | email | telegram | crypto_wallet
  value       String
  firstSeenAt DateTime @default(now()) @map("first_seen_at")
  lastSeenAt  DateTime @default(now()) @map("last_seen_at")

  @@unique([findingId, kind, value])
  @@index([brandId, kind, value])
  @@map("finding_indicators")
}

// What a search engine showed about a social-media account (pipeline/socialSearchMonitorJob.ts).
// The platforms block automated access, so this snippet -- not a page scan -- is the
// evidence a social finding is scored on.
model SocialIntel {
  id          String   @id @default(cuid())
  findingId   String   @unique @map("finding_id")
  finding     Finding  @relation(fields: [findingId], references: [id])
  brandId     String   @map("brand_id")
  platform    String // facebook | instagram | tiktok | x | telegram | youtube
  handle      String?
  // The post/video the search hit pointed at (the identifier is the account itself).
  postUrl     String?  @map("post_url")
  title       String?
  snippet     String?
  firstSeenAt DateTime @default(now()) @map("first_seen_at")
  lastSeenAt  DateTime @default(now()) @map("last_seen_at")

  @@map("social_intel")
}

// Global (not per-tenant) usage counters for metered free tiers, e.g. Tavily's 1,000
// searches/month. Read and written only through adminPrisma.
model ProviderUsage {
  provider String
  period   String // YYYY-MM
  count    Int    @default(0)

  @@id([provider, period])
  @@map("provider_usage")
}

// Global (not per-tenant): how far the CT monitor has read each log (pipeline/ctMonitorJob.ts,
// lib/ctNamesTiles.ts), keyed by the log's monitoring URL. Only touched through adminPrisma.
model CtLogCursor {
  monitoringUrl String   @id @map("monitoring_url")
  nextTile      Int      @map("next_tile") // index of the next full names tile to read
  updatedAt     DateTime @updatedAt @map("updated_at")

  @@map("ct_log_cursors")
}

model WebsiteIntel {
  id                    String   @id @default(cuid())
  findingId             String   @unique @map("finding_id")
  finding               Finding  @relation(fields: [findingId], references: [id])
  screenshotPath        String?  @map("screenshot_path")
  title                 String?
  metaDescription       String?  @map("meta_description")
  extractedText         String?  @map("extracted_text")
  hasLoginForm          Boolean  @default(false) @map("has_login_form")
  hasPaymentForm        Boolean  @default(false) @map("has_payment_form")
  looksParked           Boolean  @default(false) @map("looks_parked")
  // HTTP status of the final document. 404/410/451 count as "site down" for the
  // post-takedown watch, not as live content.
  httpStatus            Int?     @map("http_status")
  faviconHash           String?  @map("favicon_hash")
  redirectChain         String[] @map("redirect_chain")
  scannedAt             DateTime @default(now()) @map("scanned_at")
  // Regional average-hashes (lib/visualSimilarity.ts) of this scan's screenshot,
  // "|"-joined -- a different length/meaning than faviconHash, so it's its own column
  // rather than repurposing that one. Null until a brand reference screenshot exists to
  // compare against (see BrandAsset type:"screenshot") -- see visualSimilarityMatch for
  // whether this scan matched it.
  screenshotHash        String?  @map("screenshot_hash")
  visualSimilarityMatch Boolean  @default(false) @map("visual_similarity_match")

  @@map("website_intel")
}

model FindingEvidence {
  id          String   @id @default(cuid())
  findingId   String   @map("finding_id")
  finding     Finding  @relation(fields: [findingId], references: [id])
  scanId      String   @map("scan_id")
  scan        Scan     @relation(fields: [scanId], references: [id])
  description String
  data        Json?
  createdAt   DateTime @default(now()) @map("created_at")

  @@map("finding_evidence")
}

model FindingScoreEvent {
  id        String   @id @default(cuid())
  findingId String   @map("finding_id")
  finding   Finding  @relation(fields: [findingId], references: [id])
  scanId    String   @map("scan_id")
  scan      Scan     @relation(fields: [scanId], references: [id])
  delta     Int
  reason    String
  ruleCode  String   @map("rule_code")
  createdAt DateTime @default(now()) @map("created_at")

  @@map("finding_score_events")
}

model PipelineRun {
  id                String    @id @default(cuid())
  brandId           String    @map("brand_id")
  brand             Brand     @relation(fields: [brandId], references: [id])
  status            String    @default("running") // running | completed | failed
  candidatesTotal   Int       @default(0) @map("candidates_total")
  candidatesChecked Int       @default(0) @map("candidates_checked")
  findingsCreated   Int       @default(0) @map("findings_created")
  error             String?
  startedAt         DateTime  @default(now()) @map("started_at")
  finishedAt        DateTime? @map("finished_at")

  @@map("pipeline_runs")
}

model AlertRule {
  id             String   @id @default(cuid())
  organizationId String   @map("organization_id")
  kind           String // severity_threshold | score_increase | new_finding | website_activated | registration_changed | site_reactivated | public_report
  config         Json // e.g. {minSeverity:"high"} | {minDelta:20} | {minSeverity:"medium"}
  channels       String[] // email | in_app | webhook
  enabled        Boolean  @default(true)
  createdAt      DateTime @default(now()) @map("created_at")

  deliveries AlertDelivery[]

  @@map("alert_rules")
}

// findingId/scanId are not FKs to Finding/Scan on purpose: a finding can in principle be
// deleted (a future lifecycle/cleanup action) while its delivery audit trail should
// still explain what was sent and why, same reasoning as an audit_log never cascading.
model AlertDelivery {
  id          String    @id @default(cuid())
  alertRuleId String    @map("alert_rule_id")
  alertRule   AlertRule @relation(fields: [alertRuleId], references: [id])
  findingId   String    @map("finding_id")
  scanId      String    @map("scan_id")
  channel     String // email | in_app | webhook
  status      String // pending | sent | failed
  error       String?
  createdAt   DateTime  @default(now()) @map("created_at")

  @@unique([alertRuleId, findingId, scanId, channel])
  @@map("alert_deliveries")
}

model Notification {
  id             String    @id @default(cuid())
  organizationId String    @map("organization_id")
  // Null for a notification about a public report that matched no finding (a phone
  // number nobody has seen yet) -- reportId is set instead.
  findingId      String?   @map("finding_id")
  scanId         String?   @map("scan_id")
  reportId       String?   @map("report_id")
  // External page the notification is about (a fact-check article) -- set instead of
  // findingId/reportId.
  link           String?
  message        String
  readAt         DateTime? @map("read_at")
  createdAt      DateTime  @default(now()) @map("created_at")

  @@map("notifications")
}

model WebhookConfig {
  id             String  @id @default(cuid())
  organizationId String  @unique @map("organization_id")
  url            String
  secret         String
  enabled        Boolean @default(true)

  @@map("webhook_configs")
}

// A scam reported by a member of the public through /report/<token> (routes/publicReports.ts).
// Kept even when it creates no finding: a phone-only report is still evidence, and is
// matched against finding_indicators. No IP address or other device data is stored.
model PublicReport {
  id                String   @id @default(cuid())
  brandId           String   @map("brand_id")
  url               String?
  phone             String?
  description       String?
  reporterEmail     String?  @map("reporter_email")
  // The finding the reported link became (created or existing).
  findingId         String?  @map("finding_id")
  // Findings sharing a phone/WhatsApp/paybill/etc. with the report (lib/indicators.ts).
  matchedFindingIds String[] @default([]) @map("matched_finding_ids")
  // Whether this report triggered a scan -- counts toward the per-brand daily cap.
  scanQueued        Boolean  @default(false) @map("scan_queued")
  status            String   @default("new") // new | reviewed | dismissed
  createdAt         DateTime @default(now()) @map("created_at")

  @@index([brandId, createdAt])
  @@index([findingId])
  @@map("public_reports")
}

// Social posts that mention the brand but aren't threats (news, complaints, promotions,
// general chatter): what the daily social search used to discard (pipeline/brandMentions.ts).
// Identity is the post URL. category/sentiment are AI labels, null until labelled.
model BrandMention {
  id            String   @id @default(cuid())
  brandId       String   @map("brand_id")
  brand         Brand    @relation(fields: [brandId], references: [id])
  url           String
  platform      String // facebook | instagram | tiktok | x | telegram | youtube
  handle        String?
  title         String?
  snippet       String?
  category      String? // news | complaint | promotion | general
  sentiment     String? // positive | neutral | negative
  // Failed labelling attempts; labelling stops retrying a mention after a few.
  labelAttempts Int      @default(0) @map("label_attempts")
  firstSeenAt   DateTime @default(now()) @map("first_seen_at")
  lastSeenAt    DateTime @default(now()) @map("last_seen_at")

  @@unique([brandId, url])
  @@index([brandId, firstSeenAt])
  @@map("brand_mentions")
}

// Every platform-admin action, for the admin panel's audit page. No RLS and no app-role grants:
// written and read only through adminPrisma by the admin routes.
model AdminAuditLog {
  id          String   @id @default(cuid())
  adminUserId String   @map("admin_user_id")
  adminEmail  String   @map("admin_email") // kept even if that user is deleted later
  action      String // e.g. org.create, org.invite_owner
  targetType  String   @map("target_type") // org | user | brand
  targetId    String   @map("target_id")
  details     Json?
  createdAt   DateTime @default(now()) @map("created_at")

  @@index([createdAt])
  @@map("admin_audit_log")
}

// Per-brand, per-month usage of metered providers (so far Tavily: lib/tavily.ts), for the
// admin panel. Counted next to provider_usage, which holds the global monthly total that
// enforces the cap. No FK, no RLS, no app-role grants: written by the jobs and read by the
// admin routes, both through adminPrisma. Counting started 2026-11-24.
model BrandUsage {
  brandId  String @map("brand_id")
  period   String // YYYY-MM
  provider String
  count    Int    @default(0)

  @@id([brandId, period, provider])
  @@map("brand_usage")
}

// Automatic takedown reporting (TAKEDOWN_AUTOMATION_PLAN.md), per organization. Websites only.
// Every table is RLS-scoped on organization_id. Actors are stored as user id + email text, no FK,
// so the record outlives a deleted user.

// The org's own switches. enabledAt: the owner turned it on. stoppedAt: anyone from analyst up hit
// "Stop all sending"; only an owner clears it.
model TakedownAutomation {
  organizationId     String    @id @map("organization_id")
  enabledAt          DateTime? @map("enabled_at")
  enabledBy          String?   @map("enabled_by")
  stoppedAt          DateTime? @map("stopped_at")
  stoppedBy          String?   @map("stopped_by")
  stopReason         String?   @map("stop_reason")
  // Fixed text every report can use (templates: {{org.details}}, {{disclaimer}}).
  companyDetails     String?   @map("company_details")
  disclaimer         String?
  // Redirect (test) mode: when set, every report is delivered to this address instead of its real
  // recipients (lib/recipients.ts deliveryRecipients). Owner only.
  redirectTo         String?   @map("redirect_to")
  // Sending (lib/takedownPolicy.ts, pipeline/takedownDispatch.ts). stage: shadow (record what
  // would be sent, send nothing) -> redirect (deliver to redirectTo) -> live. Going live needs
  // shadowDays of shadow mode first.
  stage              String    @default("shadow")
  stageChangedAt     DateTime? @map("stage_changed_at")
  shadowStartedAt    DateTime? @map("shadow_started_at")
  shadowDays         Int       @default(14) @map("shadow_days")
  // Which findings qualify: at least this severity (unless an analyst confirmed it) and at least
  // one of these signals (login_form, payment_form, shared_indicator, scam_pattern, visual_match).
  minSeverity        String    @default("critical") @map("min_severity")
  signals            String[]  @default(["login_form", "payment_form", "shared_indicator", "scam_pattern"])
  confirmedSkipsVeto Boolean   @default(true) @map("confirmed_skips_veto")
  vetoHours          Int       @default(6) @map("veto_hours")
  dailyCap           Int       @default(25) @map("daily_cap")
  perRecipientCap    Int       @default(5) @map("per_recipient_cap")
  updatedAt          DateTime  @updatedAt @map("updated_at")

  @@map("takedown_automation")
}

// The mailbox reports are sent from (lib/orgMailer.ts): the org's own Microsoft 365 (Graph),
// Google Workspace (Gmail API) or SMTP server. config = credentials, encrypted (auth/secretBox.ts);
// publicConfig = the non-secret parts, for display. Any change clears the test result: a sender
// counts as working only after a successful test send of its current settings.
model TakedownSender {
  organizationId String    @id @map("organization_id")
  provider       String // graph | gmail | smtp
  fromAddress    String    @map("from_address")
  fromName       String?   @map("from_name")
  replyTo        String?   @map("reply_to")
  bccArchive     String?   @map("bcc_archive")
  signature      String?
  config         String
  publicConfig   Json      @map("public_config")
  lastTestAt     DateTime? @map("last_test_at")
  lastTestOk     Boolean?  @map("last_test_ok")
  lastTestError  String?   @map("last_test_error")
  lastTestTo     String?   @map("last_test_to")
  updatedAt      DateTime  @updatedAt @map("updated_at")
  updatedBy      String?   @map("updated_by")

  @@map("takedown_senders")
}

// Who authorizes reports in the org's name. Never edited: revoke and add a new one, so what was
// in force when a report went out stays on record. brandId null = every brand.
model TakedownAuthorization {
  id             String             @id @default(cuid())
  organizationId String             @map("organization_id")
  brandId        String?            @map("brand_id")
  signatoryName  String             @map("signatory_name")
  signatoryTitle String             @map("signatory_title")
  signatoryEmail String             @map("signatory_email")
  signatoryPhone String?            @map("signatory_phone")
  scope          String?
  validFrom      DateTime           @map("valid_from")
  expiresAt      DateTime?          @map("expires_at")
  revokedAt      DateTime?          @map("revoked_at")
  revokedBy      String?            @map("revoked_by")
  createdAt      DateTime           @default(now()) @map("created_at")
  createdBy      String             @map("created_by")
  documents      TakedownDocument[]

  @@index([organizationId])
  @@map("takedown_authorizations")
}

// Signed letter of authorization, trademark certificates. Kept in the database (small files,
// max 5 MB): they are evidence and go wherever the database backups go.
model TakedownDocument {
  id              String                @id @default(cuid())
  organizationId  String                @map("organization_id")
  authorizationId String                @map("authorization_id")
  authorization   TakedownAuthorization @relation(fields: [authorizationId], references: [id])
  kind            String // loa | trademark | other
  filename        String
  contentType     String                @map("content_type")
  sizeBytes       Int                   @map("size_bytes")
  sha256          String
  data            Bytes
  uploadedBy      String                @map("uploaded_by")
  createdAt       DateTime              @default(now()) @map("created_at")

  @@index([authorizationId])
  @@map("takedown_documents")
}

// The org's history of every automation setting change and test send (platform-admin
// allow/disallow included, so the org can see it).
model TakedownAutomationEvent {
  id             String   @id @default(cuid())
  organizationId String   @map("organization_id")
  actorUserId    String?  @map("actor_user_id")
  actorEmail     String?  @map("actor_email")
  action         String
  details        Json?
  createdAt      DateTime @default(now()) @map("created_at")

  @@index([organizationId, createdAt])
  @@map("takedown_automation_events")
}

// Report templates (lib/reportTemplates.ts). One template per org (or brand) x channel x kind x
// language; its text lives in versions. scopeKey = "org" or the brand id (a plain unique key, since
// Postgres treats NULL brand ids as distinct). With no template, the built-in default is used.
model TakedownTemplate {
  id             String                    @id @default(cuid())
  organizationId String                    @map("organization_id")
  brandId        String?                   @map("brand_id")
  scopeKey       String                    @map("scope_key")
  channel        String // registrar | host | cert | blocklist
  kind           String // first | follow_up | escalation
  language       String                    @default("en")
  createdAt      DateTime                  @default(now()) @map("created_at")
  versions       TakedownTemplateVersion[]

  @@unique([organizationId, scopeKey, channel, kind, language])
  @@map("takedown_templates")
}

// draft: being edited (at most one per template); published: what reports use (at most one);
// archived: an earlier published version, kept because sent reports name the version they used.
model TakedownTemplateVersion {
  id             String           @id @default(cuid())
  templateId     String           @map("template_id")
  template       TakedownTemplate @relation(fields: [templateId], references: [id])
  organizationId String           @map("organization_id")
  version        Int
  status         String // draft | published | archived
  subject        String
  body           String
  createdBy      String           @map("created_by")
  createdAt      DateTime         @default(now()) @map("created_at")
  updatedAt      DateTime         @updatedAt @map("updated_at")
  publishedBy    String?          @map("published_by")
  publishedAt    DateTime?        @map("published_at")

  @@unique([templateId, version])
  @@index([templateId, status])
  @@map("takedown_template_versions")
}

// One report to one channel about one finding. Step 2 only creates drafts: an analyst prepares
// one from the template, edits it and tests it on themself. Sending (and the other statuses:
// shadow, awaiting_approval, pending_veto, sending, sent, failed, cancelled, skipped) comes with
// the dispatcher. reportRef ([BM-...] in the subject) matches replies to the report.
model TakedownAction {
  id                String    @id @default(cuid())
  organizationId    String    @map("organization_id")
  brandId           String    @map("brand_id")
  findingId         String    @map("finding_id")
  channel           String
  kind              String
  language          String    @default("en")
  status            String    @default("draft")
  reportRef         String    @unique @map("report_ref")
  to                String[]  @default([])
  cc                String[]  @default([])
  bcc               String[]  @default([])
  subject           String
  body              String
  includeScreenshot Boolean   @default(true) @map("include_screenshot")
  documentIds       String[]  @default([]) @map("document_ids")
  // "default" (built-in text) or a TakedownTemplateVersion id.
  templateSource    String    @map("template_source")
  // Someone changed the rendered text by hand.
  edited            Boolean   @default(false)
  createdBy         String    @map("created_by")
  updatedBy         String    @map("updated_by")
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")
  lastTestAt        DateTime? @map("last_test_at")
  // How the recipients were chosen (lib/recipients.ts Routing): which contact-book rule or registry
  // record, the method (email / web form / none) and why. Shown on the finding page.
  routing           Json?
  // Sending. createdAuto: made by the dispatcher (else by an analyst). qualifiedBy: why the policy
  // picked the finding. holdReason: why a due report is waiting (cap, stop, ...).
  createdAuto       Boolean   @default(false) @map("created_auto")
  qualifiedBy       Json?     @map("qualified_by")
  sendAfter         DateTime? @map("send_after")
  approvedBy        String?   @map("approved_by")
  cancelledBy       String?   @map("cancelled_by")
  holdReason        String?   @map("hold_reason")
  skipReason        String?   @map("skip_reason")
  attempts          Int       @default(0)
  error             String?
  sentAt            DateTime? @map("sent_at")
  deliveredTo       String[]  @default([]) @map("delivered_to")
  redirected        Boolean   @default(false)
  messageId         String?   @map("message_id")
  takedownId        String?   @map("takedown_id")
  // Shadow mode review: right | wrong, and by whom.
  shadowVerdict     String?   @map("shadow_verdict")
  shadowVerdictBy   String?   @map("shadow_verdict_by")

  @@index([findingId])
  @@index([organizationId, status])
  @@map("takedown_actions")
}

// Contact book (lib/recipients.ts, TAKEDOWN_AUTOMATION_PLAN.md §3.2): where reports to a given
// registrar / host / TLD go, overriding the abuse contact in the registry record. Two layers with
// the same shape: the platform's (curated by platform admins, shared by every org; no RLS, the app
// role may only read it) and each org's own. The most specific match wins; on a tie, the org's.
// matchType: iana_id (registrar channel) > name (registrar or host name contains matchValue) > tld
// (the reported domain ends in it) > any. method: email (to emails), form (a web form, so a manual
// task), skip (never report through this channel for this match).
model TakedownContact {
  id             String   @id @default(cuid())
  organizationId String   @map("organization_id")
  channel        String
  matchType      String   @map("match_type")
  matchValue     String   @map("match_value")
  method         String
  emails         String[] @default([])
  formUrl        String?  @map("form_url")
  instructions   String?
  language       String?
  note           String?
  enabled        Boolean  @default(true)
  createdBy      String   @map("created_by")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  @@index([organizationId, channel])
  @@map("takedown_contacts")
}

model TakedownPlatformContact {
  id           String   @id @default(cuid())
  channel      String
  matchType    String   @map("match_type")
  matchValue   String   @map("match_value")
  method       String
  emails       String[] @default([])
  formUrl      String?  @map("form_url")
  instructions String?
  language     String?
  note         String?
  enabled      Boolean  @default(true)
  updatedBy    String   @map("updated_by")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@index([channel])
  @@map("takedown_platform_contacts")
}

// Addresses every report on a channel also goes to (e.g. CC legal on registrar reports).
model TakedownChannelSetting {
  organizationId String   @map("organization_id")
  channel        String
  to             String[] @default([])
  cc             String[] @default([])
  bcc            String[] @default([])
  // off (manual only) | approval (prepared, an analyst sends) | delayed (sent after the veto
  // window unless cancelled) | automatic (sent at once).
  mode           String   @default("off")
  updatedAt      DateTime @updatedAt @map("updated_at")

  @@id([organizationId, channel])
  @@map("takedown_channel_settings")
}

// Never send a report to these: an exact address, or "@domain" for a whole domain. reason manual
// (an owner/admin added it) or bounce (added automatically when replies are read, with expiresAt).
model TakedownBlockedRecipient {
  id             String    @id @default(cuid())
  organizationId String    @map("organization_id")
  value          String
  reason         String    @default("manual")
  note           String?
  expiresAt      DateTime? @map("expires_at")
  createdBy      String    @map("created_by")
  createdAt      DateTime  @default(now()) @map("created_at")

  @@unique([organizationId, value])
  @@map("takedown_blocked_recipients")
}
