generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// POC v0 note: no organization_id RLS enforcement yet (single seeded tenant, no auth).
// Table/field names match ARCHITECTURE.md §7 so this is a forward-compatible subset,
// not a throwaway schema.

model Organization {
  id        String   @id // Clerk organization id (org_...), not a generated cuid
  name      String
  createdAt DateTime @default(now()) @map("created_at")
  brands       Brand[]
  memberships  Membership[]

  @@map("organizations")
}

model User {
  id        String   @id // Clerk user id (user_...), not a generated cuid
  email     String   @unique
  name      String?
  createdAt DateTime @default(now()) @map("created_at")

  memberships      Membership[]
  assignedFindings Finding[] @relation("FindingAssignee")

  @@map("users")
}

model Membership {
  id             String   @id @default(cuid())
  userId         String   @map("user_id")
  user           User     @relation(fields: [userId], references: [id])
  organizationId String   @map("organization_id")
  organization   Organization @relation(fields: [organizationId], references: [id])
  role           String   @default("analyst") // owner | admin | analyst | viewer
  createdAt      DateTime @default(now()) @map("created_at")

  @@unique([userId, organizationId])
  @@map("memberships")
}

model Brand {
  id             String   @id @default(cuid())
  organizationId String   @map("organization_id")
  organization   Organization @relation(fields: [organizationId], references: [id])
  name           String
  primaryDomain  String   @map("primary_domain")
  createdAt      DateTime @default(now()) @map("created_at")

  domains      BrandDomain[]
  keywords     BrandKeyword[]
  assets       BrandAsset[]
  findings     Finding[]
  pipelineRuns PipelineRun[]

  @@map("brands")
}

model BrandDomain {
  id      String @id @default(cuid())
  brandId String @map("brand_id")
  brand   Brand  @relation(fields: [brandId], references: [id])
  domain  String
  type    String @default("primary") // primary | secondary | allowlist

  @@unique([brandId, domain])
  @@map("brand_domains")
}

model BrandKeyword {
  id      String @id @default(cuid())
  brandId String @map("brand_id")
  brand   Brand  @relation(fields: [brandId], references: [id])
  keyword String
  type    String @default("name") // name | concat_term

  @@unique([brandId, keyword])
  @@map("brand_keywords")
}

model BrandAsset {
  id        String   @id @default(cuid())
  brandId   String   @map("brand_id")
  brand     Brand    @relation(fields: [brandId], references: [id])
  type      String // favicon
  sourceUrl String   @map("source_url")
  hash      String
  createdAt DateTime @default(now()) @map("created_at")

  @@map("brand_assets")
}

model Finding {
  id              String   @id @default(cuid())
  brandId         String   @map("brand_id")
  brand           Brand    @relation(fields: [brandId], references: [id])
  type            String   @default("domain")
  source          String   @default("pipeline") // pipeline | seed_demo
  identifier      String // the candidate domain
  riskScore       Int      @default(0) @map("risk_score")
  severity        String   @default("low")
  status          String   @default("new")
  firstDetectedAt DateTime @default(now()) @map("first_detected_at")
  lastScannedAt   DateTime @default(now()) @map("last_scanned_at")
  // Drives the recheck dispatcher (apps/api/src/queue/dispatch.ts) -- null means never
  // enrolled for recheck (shouldn't happen once discovery sets it at creation).
  nextScanAt      DateTime? @map("next_scan_at")
  // Points at this finding's most recent Scan -- the O(1) way to fetch "current"
  // score-event/evidence breakdown without a MAX(createdAt) aggregate, now that scans
  // are append-only (see Scan below).
  lastScanId      String?   @map("last_scan_id")
  // Lifecycle: who's investigating (must be a member of this finding's org -- enforced
  // in the route, not by this FK alone, since a raw User row isn't tenant-scoped) and
  // free-form labels. Neither drives any pipeline behavior; display/filtering only.
  assigneeId      String?   @map("assignee_id")
  assignee        User?    @relation("FindingAssignee", fields: [assigneeId], references: [id])
  tags            String[] @default([])
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  domainIntel    DomainIntel?
  websiteIntel   WebsiteIntel?
  evidence       FindingEvidence[]
  scoreEvents    FindingScoreEvent[]
  scans          Scan[]
  notes          FindingNote[]
  aiExplanations AiExplanation[]
  takedowns      Takedown[]

  @@unique([brandId, identifier])
  @@map("findings")
}

model FindingNote {
  id        String   @id @default(cuid())
  findingId String   @map("finding_id")
  finding   Finding  @relation(fields: [findingId], references: [id])
  authorId  String   @map("author_id")
  body      String
  createdAt DateTime @default(now()) @map("created_at")

  @@map("finding_notes")
}

// Pure manual record-keeping -- no code here ever calls a registrar/hosting-provider API
// (that's Phase 3, out of MVP scope per ARCHITECTURE.md). One-to-many from Finding: a
// registrar report and a hosting-provider report are independent efforts with their own
// tickets/timelines, tracked as separate rows rather than fields on Finding.
model Takedown {
  id            String    @id @default(cuid())
  findingId     String    @map("finding_id")
  finding       Finding   @relation(fields: [findingId], references: [id])
  provider      String // free text, e.g. "registrar" / "GoDaddy" / "hosting provider"
  reference     String? // their ticket/case number
  status        String    @default("requested") // requested | acknowledged | completed | rejected
  notes         String?
  requestedById String    @map("requested_by_id") // always server-set from the caller's token
  requestedAt   DateTime  @default(now()) @map("requested_at")
  // First-ever transition into completed/rejected -- set once, never overwritten by a
  // later correction (mirrors firstDetectedAt vs. lastScannedAt's "first fact vs. latest
  // fact" split above). A status correction after the fact belongs in `notes`, not here.
  resolvedAt    DateTime? @map("resolved_at")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  @@map("takedown_requests")
}

// One row per discovery/recheck execution against a finding. Score events/evidence are
// append-only and tagged with the scan that produced them (see FindingScoreEvent/
// FindingEvidence below) -- this is what makes "show only the current breakdown" and "show
// full history over time" both possible from the same append-only data, instead of having
// to choose one. A scan's score/severity are an absolute recomputation each time
// (computeScore in scoring.ts), never incremental -- a future timeline view must group by
// scan, never flatten FindingScoreEvent rows across scans (that would double-count a rule
// like a homoglyph match that's still true on every recheck).
model Scan {
  id          String    @id @default(cuid())
  findingId   String    @map("finding_id")
  finding     Finding   @relation(fields: [findingId], references: [id])
  kind        String // discovery | recheck
  triggeredBy String    @map("triggered_by") // manual | scheduled
  score       Int?
  severity    String?
  startedAt   DateTime  @default(now()) @map("started_at")
  finishedAt  DateTime? @map("finished_at")
  error       String?

  scoreEvents   FindingScoreEvent[]
  evidence      FindingEvidence[]
  aiExplanation AiExplanation?

  @@map("scans")
}

// One row per (attempted) AI narration of a scan's deterministic score/evidence -- keyed
// by scanId, never findingId, so it can't go stale: Scan.id is always a fresh cuid and
// Finding.lastScanId only ever advances forward, so once a recheck moves on, the old
// explanation simply stops matching rather than needing an "outdated" flag maintained
// elsewhere. `prompt` is the exact context sent to the model -- the audit trail
// ARCHITECTURE.md §9 requires. status/error are written even on failure (not just
// success) so a failed attempt still counts toward the per-org rate limit in
// routes/findings.ts and leaves an honest record, rather than a silent, unaudited spend.
model AiExplanation {
  id        String   @id @default(cuid())
  scanId    String   @unique @map("scan_id")
  scan      Scan     @relation(fields: [scanId], references: [id])
  findingId String   @map("finding_id")
  finding   Finding  @relation(fields: [findingId], references: [id])
  prompt    String
  response  String?
  model     String
  status    String   @default("pending") // pending | succeeded | failed
  error     String?
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("ai_explanations")
}

model DomainIntel {
  id           String    @id @default(cuid())
  findingId    String    @unique @map("finding_id")
  finding      Finding   @relation(fields: [findingId], references: [id])
  registrar    String?
  registeredAt DateTime? @map("registered_at")
  nameservers  String[]
  ip           String?
  dnsRecords   Json?     @map("dns_records")
  whoisSource  String?   @map("whois_source") // rdap | whois | unavailable
  rawData      Json?     @map("raw_data")
  // First-ever time DNS delegation was observed for this domain -- set once, never
  // overwritten (same "first fact, never overwritten" pattern as Finding.firstDetectedAt
  // and Takedown.resolvedAt). Null means we've never once confirmed this domain actually
  // resolves -- still just a candidate, not a proven registration. currentlyResolves
  // reflects only the LATEST scan, so `firstResolvedAt != null && !currentlyResolves` is
  // the "was registered, isn't anymore" (lapsed) case a typosquat can genuinely hit --
  // e.g. a brief test-registration, or a hold period expiring after discovery flagged it.
  firstResolvedAt   DateTime? @map("first_resolved_at")
  currentlyResolves Boolean   @default(false) @map("currently_resolves")

  @@map("domain_intel")
}

model WebsiteIntel {
  id              String   @id @default(cuid())
  findingId       String   @unique @map("finding_id")
  finding         Finding  @relation(fields: [findingId], references: [id])
  screenshotPath  String?  @map("screenshot_path")
  title           String?
  metaDescription String?  @map("meta_description")
  extractedText   String?  @map("extracted_text")
  hasLoginForm    Boolean  @default(false) @map("has_login_form")
  hasPaymentForm  Boolean  @default(false) @map("has_payment_form")
  looksParked     Boolean  @default(false) @map("looks_parked")
  faviconHash     String?  @map("favicon_hash")
  redirectChain   String[] @map("redirect_chain")
  scannedAt       DateTime @default(now()) @map("scanned_at")
  // Regional average-hashes (lib/visualSimilarity.ts) of this scan's screenshot,
  // "|"-joined -- a different length/meaning than faviconHash, so it's its own column
  // rather than repurposing that one. Null until a brand reference screenshot exists to
  // compare against (see BrandAsset type:"screenshot") -- see visualSimilarityMatch for
  // whether this scan matched it.
  screenshotHash       String?  @map("screenshot_hash")
  visualSimilarityMatch Boolean @default(false) @map("visual_similarity_match")

  @@map("website_intel")
}

model FindingEvidence {
  id          String   @id @default(cuid())
  findingId   String   @map("finding_id")
  finding     Finding  @relation(fields: [findingId], references: [id])
  scanId      String   @map("scan_id")
  scan        Scan     @relation(fields: [scanId], references: [id])
  description String
  data        Json?
  createdAt   DateTime @default(now()) @map("created_at")

  @@map("finding_evidence")
}

model FindingScoreEvent {
  id        String   @id @default(cuid())
  findingId String   @map("finding_id")
  finding   Finding  @relation(fields: [findingId], references: [id])
  scanId    String   @map("scan_id")
  scan      Scan     @relation(fields: [scanId], references: [id])
  delta     Int
  reason    String
  ruleCode  String   @map("rule_code")
  createdAt DateTime @default(now()) @map("created_at")

  @@map("finding_score_events")
}

model PipelineRun {
  id                String    @id @default(cuid())
  brandId           String    @map("brand_id")
  brand             Brand     @relation(fields: [brandId], references: [id])
  status            String    @default("running") // running | completed | failed
  candidatesTotal   Int       @default(0) @map("candidates_total")
  candidatesChecked Int       @default(0) @map("candidates_checked")
  findingsCreated   Int       @default(0) @map("findings_created")
  error             String?
  startedAt         DateTime  @default(now()) @map("started_at")
  finishedAt        DateTime? @map("finished_at")

  @@map("pipeline_runs")
}

model AlertRule {
  id             String   @id @default(cuid())
  organizationId String   @map("organization_id")
  kind           String // severity_threshold | score_increase | new_finding
  config         Json // e.g. {minSeverity:"high"} | {minDelta:20} | {minSeverity:"medium"}
  channels       String[] // email | in_app | webhook
  enabled        Boolean  @default(true)
  createdAt      DateTime @default(now()) @map("created_at")

  deliveries AlertDelivery[]

  @@map("alert_rules")
}

// findingId/scanId are not FKs to Finding/Scan on purpose: a finding can in principle be
// deleted (a future lifecycle/cleanup action) while its delivery audit trail should
// still explain what was sent and why, same reasoning as an audit_log never cascading.
model AlertDelivery {
  id          String   @id @default(cuid())
  alertRuleId String   @map("alert_rule_id")
  alertRule   AlertRule @relation(fields: [alertRuleId], references: [id])
  findingId   String   @map("finding_id")
  scanId      String   @map("scan_id")
  channel     String // email | in_app | webhook
  status      String // pending | sent | failed
  error       String?
  createdAt   DateTime @default(now()) @map("created_at")

  @@unique([alertRuleId, findingId, scanId, channel])
  @@map("alert_deliveries")
}

model Notification {
  id             String    @id @default(cuid())
  organizationId String    @map("organization_id")
  findingId      String    @map("finding_id")
  scanId         String    @map("scan_id")
  message        String
  readAt         DateTime? @map("read_at")
  createdAt      DateTime  @default(now()) @map("created_at")

  @@map("notifications")
}

model WebhookConfig {
  id             String  @id @default(cuid())
  organizationId String  @unique @map("organization_id")
  url            String
  secret         String
  enabled        Boolean @default(true)

  @@map("webhook_configs")
}
