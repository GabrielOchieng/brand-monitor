# Production env for the API container on the VPS (Dokploy Application -> Environment).
# Reference copy only: the real values live in Dokploy. See DEPLOYMENT.md §1-§2.

# Both point at the shared Postgres server's INTERNAL host (no public port). `brandmonitor`
# owns the database and needs CREATEROLE + BYPASSRLS (DEPLOYMENT.md §1). `brandmonitor_app`
# is created by the RLS migration; the entrypoint sets its password from this URL on every
# start, so any new letters+digits password works.
DATABASE_URL="postgresql://brandmonitor:<owner-password>@infra-postgresshared-zdz0e1:5432/brandmonitor"
DATABASE_APP_URL="postgresql://brandmonitor_app:<app-password>@infra-postgresshared-zdz0e1:5432/brandmonitor"

# Scanner runs as a second process inside this same container -- 127.0.0.1, never exposed.
SCANNER_URL="http://127.0.0.1:3100"

# No PORT: the app defaults to 4000, which is the container port the Dokploy domain points at.

# Concurrent headless-Chromium scans (~0.5-0.7 GB each). The VPS is shared with other apps;
# check free RAM before raising.
RECHECK_CONCURRENCY=3

# Clerk DEV instance keys (permanent by decision -- DEPLOYMENT.md §4). Webhook endpoint:
# https://brand-monitor-api.gabrielochieng.com/api/webhooks/clerk
CLERK_SECRET_KEY=""
CLERK_WEBHOOK_SIGNING_SECRET=""

# SMTP for alert emails -- a Gmail app-password works for this volume.
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=465
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM=""

# Must exactly equal the Vercel origin: used for email links AND as the CORS allowlist.
WEB_APP_URL="https://brand-monitor-web-eta.vercel.app"

# AI explanations: free Gemini key from aistudio.google.com (personal account, no card).
# AI_BASE_URL/AI_MODEL default to Gemini; AI_MODEL is a comma-separated fallback chain.
AI_API_KEY=""
AI_EXPLANATION_DAILY_LIMIT=100

# Optional (DEPLOYMENT.md §3): social search, and the public report form's captcha
# (set TURNSTILE_SECRET_KEY only together with NEXT_PUBLIC_TURNSTILE_SITE_KEY on Vercel).
TAVILY_API_KEY=""
TAVILY_MONTHLY_CAP=900
TURNSTILE_SECRET_KEY=""
