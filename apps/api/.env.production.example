# Production env for the Oracle Cloud VM (docker-compose.prod.yml's `api` service). Copy
# this to `apps/api/.env.production` (gitignored) and fill in real values -- see
# DEPLOYMENT.md for the full runbook this file is one step of.

# Both URLs point at Neon (not a local container) -- use the DIRECT (non-pooled)
# connection string Neon gives you, not the pooled/PgBouncer one: this is a long-running
# server managing its own Prisma connection pool, not a serverless function making many
# short-lived connections, so Neon's pooler (built for the latter) isn't needed and would
# just add a variable worth avoiding. `sslmode=require` is mandatory -- Neon rejects plain
# connections.
#
# DATABASE_URL is Neon's own default role (already a member of neon_superuser, which
# carries CREATEROLE -- confirmed sufficient for the existing
# 20260910000000_multi_tenancy_rls migration's `CREATE ROLE brandmonitor_app ...` to run
# unmodified against Neon, same as it does against the local dev Postgres container).
# DATABASE_APP_URL is that brandmonitor_app role the migration creates -- pick a real
# password for it (the migration's hardcoded dev password is fine for local Postgres only,
# never for anything internet-reachable).
DATABASE_URL="postgresql://<neon-role>:<neon-password>@<neon-host>/<db>?sslmode=require"
DATABASE_APP_URL="postgresql://brandmonitor_app:<a-real-password>@<neon-host>/<db>?sslmode=require"

# Docker's own internal service-name DNS (see docker-compose.prod.yml) -- a completely
# different mechanism from the 127.0.0.1-vs-localhost IPv6 gotcha documented in the dev
# .env.example (that was a Docker-Desktop-on-Windows quirk specific to local dev; it
# doesn't apply here). `scanner` resolves to the scanner container over the compose
# network and is never reachable from outside it.
SCANNER_URL="http://scanner:3100"
PORT=4000

# Clerk -- use a PRODUCTION instance's keys, not the dev instance used for local testing.
# Dev instances have dev-mode restrictions not meant for a real deployed domain; create a
# Production instance in the Clerk dashboard, add this deployment's domain to it, and
# update its webhook URL to point at https://<API_DOMAIN>/api/webhooks/clerk (or whatever
# the actual webhook route is) once the API is reachable.
CLERK_SECRET_KEY=""
CLERK_WEBHOOK_SIGNING_SECRET=""

# SMTP for alert emails -- same as dev; a Gmail app-password works for MVP volume.
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=465
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM=""

# The real Vercel production URL (or a custom domain on it), used to build links back to
# the web app in alert emails.
WEB_APP_URL="https://your-app.vercel.app"

ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL="claude-sonnet-5"
AI_EXPLANATION_DAILY_LIMIT=100
